# Copy this file to .env and adjust values for your environment.
# Never commit the real .env file.
#
# Generated by nexus-edge's `make new-project` - port defaults below are
# a starting point (offset from nexus-edge's own dev stack), NOT
# scanned for actual collisions. Check `docker ps` / `docker compose
# ls` before running this alongside other projects and adjust anything
# that clashes (docs/CREATING_A_TARGET_PROJECT.md's "Known trap"
# section has the full story on why EDGEX_*_PORT vars specifically are
# not safe to just reassign).

NODE_ENV=development

# IANA timezone of the machine this stack runs on (the one installed next
# to the hardware) - required by api/orchestrator (docker-compose.yml
# fails fast without it). "Now" - minute of day, day of week/month/year -
# is computed in it, and the UI follows this server clock rather than
# the browser's own. Containers run in UTC otherwise. Use the host's own
# value: `timedatectl show -p Timezone --value` (or /etc/timezone).
TZ=UTC

# --- This project's identity + where nexus-edge (Core+Base) lives
# (Фаза В extension points design, nexus-edge AGENTS_TO_DO.md 2026-07-29) ---
# Shown in the UI next to the logo (apps/ui/src/projectName.js).
PROJECT_NAME=__PROJECT_NAME__
# Matches docker-compose.yml's top-level "name:" (the compose project
# name) - used by scripts/check-ports.sh to tell "occupied by this
# project's own containers" apart from a real port collision. Keep in
# sync if you ever rename the compose project.
SLUG=__SLUG__
# Absolute or relative path to a nexus-edge checkout - not required to
# be a sibling directory (docker-compose.yml's build.context/
# additional_contexts read this). Lets several nexus-edge versions be
# checked out side by side for active development, each target project
# pointing at whichever one it needs.
NEXUS_EDGE_SOURCE_PATH=__NEXUS_EDGE_SOURCE_PATH__
# nexus-edge's own package.json "version" at the time this project was
# generated/last updated - compared against the current value at
# NEXUS_EDGE_SOURCE_PATH by `make build` (warns on mismatch, does not
# block).
NEXUS_EDGE_VERSION=__NEXUS_EDGE_VERSION__

# --- Orchestrator ---
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=3120

# --- Device API ---
API_HOST=0.0.0.0
API_PORT=3121

# --- Messaging Gateway (RabbitMQ -> WebSocket fan-out for the UI) ---
MESSAGING_GATEWAY_HOST=0.0.0.0
MESSAGING_GATEWAY_PORT=3131

# --- UI ---
UI_PORT=8081

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=__SLUG__
POSTGRES_USER=__SLUG__
POSTGRES_PASSWORD=change-me
# Host-side port only, for connecting a local client from outside Docker
# - a non-standard default so it doesn't collide with nexus-edge's own
# dev stack (POSTGRES_HOST_PORT=55432 there) or a local Postgres.
POSTGRES_HOST_PORT=55532

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- RabbitMQ ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=__SLUG__
RABBITMQ_DEFAULT_PASS=change-me

# --- Process public-state broadcast ---
PROCESS_STATE_BROADCAST_INTERVAL_MS=5000

# --- Auth (UI login only) ---
JWT_SECRET=change-me
# The internal services (orchestrator, device-service) reach the API with this
# token instead of a session - a long random string (openssl rand -base64 32).
SERVICE_API_TOKEN=
# Sessions: lapse after this many minutes of no use; never longer than this
# many hours from the sign-in.
AUTH_SESSION_IDLE_MINUTES=120
AUTH_SESSION_MAX_HOURS=12
# The demo mode (a public read-only instance): visitors are signed in as the
# demo account; the AI Assistant for them (on / off, a daily token budget
# shared by all visitors); at DEMO_RESET_AT (HH:MM, empty - never) the
# visitors' conversations are removed.
DEMO_MODE=false
DEMO_AI_ENABLED=false
DEMO_AI_DAILY_TOKENS=50000
DEMO_RESET_AT=
# Logs older than LOG_RETENTION_DAYS are cleared every day at LOG_RETENTION_AT
# (0 - kept forever); the time series' raw samples are kept
# SAMPLES_RETENTION_DAYS (0 - forever; the hourly / daily aggregates stay).
LOG_RETENTION_DAYS=0
LOG_RETENTION_AT=03:30
SAMPLES_RETENTION_DAYS=0
ADMIN_DEFAULT_PASSWORD=change-me
SYSTEM_DEFAULT_PASSWORD=change-me
# The simulation's account (..._seed-simulator-user.ts).
SIMULATOR_DEFAULT_PASSWORD=change-me
AVATAR_UPLOAD_DIR=/workspace/apps/api/uploads/avatars
AVATAR_MAX_SIZE_BYTES=2097152
# a Dashboard card's own picture / background (stored in the database)
DASHBOARD_IMAGE_MAX_BYTES=1048576
# a larger upload (up to this) is shrunk to fit: the longest side, WebP qualities tried in turn
DASHBOARD_IMAGE_UPLOAD_MAX_BYTES=8388608
DASHBOARD_IMAGE_MAX_SIDE=1600
DASHBOARD_IMAGE_WEBP_QUALITIES=86,76,64,50

# --- EdgeX Foundry (Palau 4.0.2, no-security profile) ---
EDGEX_CORE_METADATA_HOST=edgex-core-metadata
# Always 59881 - EdgeX's own container-internal listen port, unrelated
# to whatever host port docker-compose.edgex.yml maps it to for local
# debugging. Do not change (bug found 2026-07-28, nexus-edge-smart-house:
# this was set to a host-only offset port here, which broke apps/api's
# own internal EdgeX connection - GET /devices list silently returned
# edgex:null for every device, ECONNREFUSED in api's logs).
EDGEX_CORE_METADATA_PORT=59881
EDGEX_CORE_DATA_HOST=edgex-core-data
EDGEX_CORE_DATA_PORT=59880
EDGEX_CORE_COMMAND_HOST=edgex-core-command
EDGEX_CORE_COMMAND_PORT=59882
# The device-service's name in EdgeX - devices registered through the API are bound to it.
EDGEX_DEVICE_SERVICE_NAME=device-nexus-edge
# EdgeX's internal message bus - read by the API's device push bridge
# (AGENTS.md section 80). Unset = pushes not bridged (polling still works).
EDGEX_MESSAGEBUS_HOST=edgex-mqtt-broker
EDGEX_MESSAGEBUS_PORT=1883
EDGEX_CORE_KEEPER_HOST=edgex-core-keeper
EDGEX_CORE_KEEPER_PORT=59890
# Host-side debug port only (docker-compose.edgex.yml) - give this a
# project-unique value if running several target projects side by side.
EDGEX_METADATA_HOST_PORT=59981

# --- Device broker (MQTT for network nodes, AGENTS.md section 79) ---
# Host port nodes on the LAN connect to (container side is always 1883).
# Check `docker ps` before changing - must be unique per stack running
# side by side on this host.
DEVICE_MQTT_HOST_PORT=1983
# First topic level of every device topic: <root>/<node>/<device>/state|set
DEVICE_MQTT_TOPIC_ROOT=nexus
# device-service's own client id on the device broker.
DEVICE_MQTT_CLIENT_ID=__SLUG__-device-service

# --- Media Store (device media such as camera frames, AGENTS.md section 81) ---
# Container path of the api-media volume, and the per-file size limit.
MEDIA_DIR=/workspace/apps/api/media
MEDIA_MAX_FILE_BYTES=8388608
# How long device-service waits for one frame upload to the Media Store.
DEVICE_MEDIA_UPLOAD_TIMEOUT_SECONDS=30

# --- AI layer (AGENTS.md section 82; connections - Service -> Config -> AI) ---
# The master key the AI connections' API keys are stored encrypted with -
# any long random string (e.g. `openssl rand -base64 32`). Changing it makes
# the stored keys unreadable (re-enter them).
AI_SECRETS_KEY=
# Imported ONCE as the first connection when there is none (may be removed
# afterwards). No connection = AI unavailable: analyses are stored as
# failed, nothing else breaks.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_REQUEST_TIMEOUT_MS=25000
# One model call of an AI Assistant conversation (long contexts with tool results).
AI_CHAT_TIMEOUT_MS=90000
# The AI Assistant's "Quick start" for a newcomer - the whole system's work types offered first.
AI_QUICK_START=status-analysis,wem-analysis,analysis-proposals
# An answer's tokens when a connection sets no limit of its own.
AI_MAX_OUTPUT_TOKENS=2048
# The AI Assistant's resource gateway: a tool answer's size limit (characters)
# and the documentation it searches ("label=dir", comma-separated; the
# default: core=/workspace/docs-core, library=/workspace/devices,
# project=/workspace/project-docs, plugins=/workspace/plugins).
AI_TOOL_MAX_CHARS=12000
# AI_DOCS_SOURCES=
# The AI Assistant's calendar: how often the orchestrator starts the due
# scheduled runs (ms), how late a run may still start (minutes - the system
# down longer skips it), the language the runs report in.
AI_CALENDAR_INTERVAL_MS=60000
AI_CALENDAR_CATCH_UP_MIN=30
AI_SCHEDULED_LANGUAGE=English
# Longest side of the copy sent for analysis (the original is kept as is).
AI_IMAGE_MAX_SIDE=1536
# Longest side of generated thumbnails.
MEDIA_PREVIEW_MAX_SIDE=320

# --- UI reverse proxy ---
# Largest request body nginx forwards to the api (nginx size syntax). Must
# stay >= the api's largest upload limit (MEDIA_MAX_FILE_BYTES) plus
# multipart overhead. Required - nginx won't start without it.
API_MAX_REQUEST_BODY_SIZE=10m
